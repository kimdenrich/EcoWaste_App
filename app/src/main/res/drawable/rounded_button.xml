<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color -->
    <solid android:color="#0E8E00" />  <!-- Green, change to your color -->

    <!-- Corner radius -->
    <corners android:radius="12dp" />  <!-- Change radius here -->

    <!-- Optional padding -->
    <padding
        android:left="12dp"
        android:top="10dp"
        android:right="12dp"
        android:bottom="10dp"/>
</shape>
